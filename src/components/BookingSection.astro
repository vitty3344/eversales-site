---
// src/components/BookingSection.astro
interface Props {
  title?: string;
  subtitle?: string;
  calendarUrl?: string;
  features?: string[];
}

const { 
  title = "Book your Strategy Audit", 
  subtitle = "Find out exactly where your sales engine is leaking revenue.",
  // Defaulting to the Google Calendar link you provided earlier
  calendarUrl = "https://calendar.google.com/calendar/appointments/AcZssZ2p2v-Z2ppqP4ojEUxfZGAZ3JhLfGlSK4oFJj8=?gv=true",
  features = [
    "We analyze your current sales process and closing rates.",
    "We identify the #1 bottleneck stopping you from scaling.",
    "You get a roadmap: Hiring, Scripting, or Training."
  ]
} = Astro.props;
---

<section id="book" class="py-12 md:py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden flex flex-col lg:flex-row min-h-[700px]">
      
      <div class="w-full lg:w-5/12 bg-slate-900 p-8 md:p-12 text-white flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 blur-[80px] rounded-full translate-x-1/2 -translate-y-1/2"></div>
        
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/50 border border-blue-700/50 text-blue-400 text-xs font-bold uppercase tracking-wide mb-6">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            Limited Availability
          </div>

          <h2 class="text-3xl md:text-4xl font-extrabold mb-6 leading-tight">{title}</h2>
          <p class="text-slate-400 text-lg mb-8 leading-relaxed">
            {subtitle}
          </p>

          <div class="space-y-6">
            <h4 class="text-sm font-bold uppercase tracking-widest text-slate-500">What happens on this call?</h4>
            
            <ul class="space-y-4">
              {features.map((feature) => (
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 rounded-full bg-blue-600/20 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <span class="text-slate-300">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="relative z-10 pt-12 border-t border-slate-800 mt-12">
          </div>
      </div>

  <div id="calendar-loading" class="absolute inset-0 flex items-center justify-center bg-slate-50 z-0 h-[700px]">
          <div class="flex flex-col items-center gap-3">
             <div class="w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
             <p class="text-sm text-slate-400 font-medium">Loading Calendar...</p>
          </div>
        </div>

        <div class="relative z-10 w-full" id="iframe-container">
          <iframe 
            src={calendarUrl}
            onload="document.getElementById('calendar-loading').style.display='none';"
            class="w-full bg-white"
            style="border: 0; min-width: 320px; height: 700px;" 
            frameborder="0">
          <iframe 
            src={calendarUrl}
            class="w-full"
            style="border: 0; min-width: 320px; height: 700px;" 
            frameborder="0">
          </iframe>
        </div>

        <div id="post-booking-action" class="relative z-10 p-6 bg-slate-50 border-t border-slate-100 opacity-0 transition-opacity duration-1000 hidden flex-col items-center justify-center text-center">
            <p class="text-slate-600 mb-3 font-medium">Finished securing your time?</p>
            <a href="/thank-you" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-colors w-full sm:w-auto">
              Continue to Next Steps
              <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
        </div>

      </div>
    </div>
  </div>
  
  <script is:inline>
    // Since we can't detect a successful booking due to CORS, 
    // we detect when the user clicks inside the iframe area, 
    // and then reveal the "Continue" button after a short delay.
    
    document.addEventListener("DOMContentLoaded", () => {
      let interactionDetected = false;
      
      // We monitor when the window focus shifts to the iframe
      window.addEventListener('blur', function() {
        const activeElement = document.activeElement;
        if (activeElement && activeElement.tagName === 'IFRAME') {
          triggerPostBookingUI();
        }
      });

      // Backup trigger: mouse entering the iframe area
      const iframeContainer = document.getElementById('iframe-container');
      if(iframeContainer) {
        iframeContainer.addEventListener('mouseenter', () => {
           triggerPostBookingUI();
        }, { once: true });
      }

      function triggerPostBookingUI() {
        if (interactionDetected) return;
        interactionDetected = true;
        
        const actionDiv = document.getElementById('post-booking-action');
        
        // Wait 15 seconds after they start interacting with the calendar to show the button
        // so it doesn't distract them while picking a date.
        setTimeout(() => {
          actionDiv.classList.remove('hidden');
          actionDiv.classList.add('flex');
          // Slight delay to allow display:flex to apply before animating opacity
          setTimeout(() => {
            actionDiv.classList.remove('opacity-0');
            actionDiv.classList.add('opacity-100');
          }, 50);
        }, 15000); 
      }
    });
  </script>
</section>