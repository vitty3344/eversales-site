---
// src/components/BookingSection.astro
interface Props {
  title?: string;
  subtitle?: string;
  calendarUrl?: string;
  // New prop for dynamic bullets
  features?: string[];
}

const { 
  title = "Book your Strategy Audit", 
  subtitle = "Find out exactly where your sales engine is leaking revenue.",
  calendarUrl = calendarUrl,
  features = [
    "We analyze your current sales process and closing rates.",
    "We identify the #1 bottleneck stopping you from scaling.",
    "You get a roadmap: Hiring, Scripting, or Training."
  ]
} = Astro.props;
---

<section id="book" class="py-12 md:py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden flex flex-col lg:flex-row min-h-[700px]">
      
      <div class="w-full lg:w-5/12 bg-slate-900 p-8 md:p-12 text-white flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 blur-[80px] rounded-full translate-x-1/2 -translate-y-1/2"></div>
        
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/50 border border-blue-700/50 text-blue-400 text-xs font-bold uppercase tracking-wide mb-6">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            Limited Availability
          </div>

          <h2 class="text-3xl md:text-4xl font-extrabold mb-6 leading-tight">{title}</h2>
          <p class="text-slate-400 text-lg mb-8 leading-relaxed">
            {subtitle}
          </p>

          <div class="space-y-6">
            <h4 class="text-sm font-bold uppercase tracking-widest text-slate-500">What happens on this call?</h4>
            
            <ul class="space-y-4">
              {features.map((feature) => (
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 rounded-full bg-blue-600/20 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <span class="text-slate-300">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="relative z-10 pt-12 border-t border-slate-800 mt-12">
          </div>
      </div>

      <div class="w-full lg:w-7/12 bg-white relative">
        <div class="absolute inset-0 flex items-center justify-center bg-slate-50 z-0">
          <div class="flex flex-col items-center gap-3">
             <div class="w-8 h-8 border-4 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
             <p class="text-sm text-slate-400 font-medium">Loading Calendar...</p>
          </div>
        </div>

        <div 
          class="calendly-inline-widget relative z-10" 
          data-url={calendarUrl}
          style="min-width:320px;height:700px;">
        </div>
      </div>

    </div>
  </div>
  
  <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
  <script is:inline>
    window.addEventListener('message', function(e) {
      if (e.data.event && e.data.event.includes('scheduled')) {
        window.location.href = '/thank-you';
      }
    });
  </script>
</section>