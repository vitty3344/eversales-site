---
// src/components/ConsentToast.astro
---

<div 
  id="consent-toast" 
  class="fixed bottom-6 right-6 z-[100] w-[320px] md:w-[400px] transform translate-x-[120%] transition-transform duration-700 ease-out"
>
  <div class="bg-white/90 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-2xl overflow-hidden relative">
    
    <div class="p-5 md:p-6 flex items-start gap-4">
      <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      
      <div class="flex-1">
        <p class="text-sm text-slate-600 leading-relaxed">
          By continuing to use this site, you agree to our 
          <a href="/terms" class="text-blue-600 font-bold hover:underline">Terms</a> and 
          <a href="/privacy-policy" class="text-blue-600 font-bold hover:underline">Privacy Policy</a>.
        </p>
      </div>

      <button id="close-toast" class="text-slate-400 hover:text-slate-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="absolute bottom-0 left-0 h-1 bg-blue-600 w-full" id="toast-progress"></div>
  </div>
</div>

<style>
  @keyframes shrink {
    from { width: 100%; }
    to { width: 0%; }
  }
  
  .animate-progress {
    /* UPDATED: Animation now takes 6 seconds */
    animation: shrink 6s linear forwards;
  }
</style>

<script is:inline>
  function initConsent() {
    const toast = document.getElementById('consent-toast');
    const progress = document.getElementById('toast-progress');
    const closeBtn = document.getElementById('close-toast');
    
    const hasSeen = localStorage.getItem('eversales_consent_seen');
    
    if (!hasSeen) {
      setTimeout(() => {
        toast.classList.remove('translate-x-[120%]');
        progress.classList.add('animate-progress');

        // UPDATED: Auto-dismiss after 6 seconds (6000ms)
        setTimeout(() => {
          dismissToast();
        }, 6000);
      }, 1500);
    }

    function dismissToast() {
      if (toast) {
        toast.classList.add('translate-x-[120%]');
        localStorage.setItem('eversales_consent_seen', 'true');
      }
    }

    closeBtn?.addEventListener('click', dismissToast);
  }

  initConsent();
  document.addEventListener('astro:page-load', initConsent);
</script>