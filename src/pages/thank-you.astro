---
// src/pages/thank-you.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Booking Confirmed | Eversales">
  
  <style>
    /* 1. DRAW-IN ANIMATION FOR CHECKMARK */
    .checkmark-svg {
      width: 80px;
      height: 80px;
    }
    
    .checkmark-circle {
      stroke-dasharray: 166;
      stroke-dashoffset: 166;
      stroke-width: 2;
      stroke-miterlimit: 10;
      stroke: #22c55e;
      fill: none;
      animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }

    .checkmark-check {
      transform-origin: 50% 50%;
      stroke-dasharray: 48;
      stroke-dashoffset: 48;
      stroke: #22c55e;
      stroke-width: 3;
      fill: none;
      animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.6s forwards;
    }

    @keyframes stroke {
      100% { stroke-dashoffset: 0; }
    }

    /* 2. ICON POP IN */
    .icon-wrapper {
      animation: pop-in 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      opacity: 0;
      transform: scale(0);
    }
    @keyframes pop-in {
      100% { transform: scale(1); opacity: 1; }
    }

    /* 3. SPARKLES ANIMATION */
    .sparkle {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      opacity: 0;
      z-index: -1;
    }
    
    .s-1 { background: #fbbf24; animation: fly-1 0.8s ease-out 0.5s forwards; }
    .s-2 { background: #3b82f6; animation: fly-2 0.8s ease-out 0.5s forwards; }
    .s-3 { background: #22c55e; animation: fly-3 0.8s ease-out 0.5s forwards; }
    .s-4 { background: #fbbf24; animation: fly-4 0.8s ease-out 0.5s forwards; }
    .s-5 { background: #3b82f6; animation: fly-5 0.8s ease-out 0.5s forwards; }
    .s-6 { background: #22c55e; animation: fly-6 0.8s ease-out 0.5s forwards; }

    @keyframes fly-1 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(-60px, -80px) scale(1); } }
    @keyframes fly-2 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(60px, -80px) scale(1); } }
    @keyframes fly-3 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(80px, 0px) scale(1); } }
    @keyframes fly-4 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(60px, 80px) scale(1); } }
    @keyframes fly-5 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(-60px, 80px) scale(1); } }
    @keyframes fly-6 { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(-80px, 0px) scale(1); } }

    /* 4. GENTLE BOUNCE FOR TEXT */
    @keyframes bounce-gentle {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }
    .animate-bounce-gentle {
      animation: bounce-gentle 3s infinite ease-in-out;
    }
  </style>

  <main class="min-h-screen bg-slate-50 flex items-center justify-center px-4 md:px-6 pt-20 pb-20">
    
    <div class="max-w-2xl w-full bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden text-center p-8 md:p-12 pt-20 relative">
      
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-green-500/5 blur-[80px] rounded-full pointer-events-none"></div>

      <div class="relative w-24 h-24 mx-auto mb-10 mt-2">
        <div class="icon-wrapper w-full h-full bg-green-50 rounded-full flex items-center justify-center shadow-inner shadow-green-100 relative z-10">
          <svg class="checkmark-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
            <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none"/>
            <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
          </svg>
        </div>
        
        <div class="s-1 sparkle"></div>
        <div class="s-2 sparkle"></div>
        <div class="s-3 sparkle"></div>
        <div class="s-4 sparkle"></div>
        <div class="s-5 sparkle"></div>
        <div class="s-6 sparkle"></div>
      </div>

      <div class="relative z-10">
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4 animate-bounce-gentle">You're all set!</h1>
        <p class="text-lg text-slate-500 mb-12 leading-relaxed max-w-lg mx-auto">
          Your call has been confirmed. We've sent a calendar invitation with the Zoom link to your email.
        </p>
        
        <div class="bg-slate-50 rounded-2xl p-8 md:p-10 mb-12 border border-slate-100">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8 md:mb-10">What Happens Next</p>
          
          <div class="relative flex flex-col md:flex-row justify-between items-center md:items-start gap-8 md:gap-0">
            
            <div class="hidden md:block absolute top-7 left-14 right-14 h-1 bg-slate-200 -z-10"></div>

            <div class="flex flex-col items-center gap-4 w-full md:w-1/3 px-2">
              <div class="w-14 h-14 min-w-[3.5rem] shrink-0 rounded-full bg-white border-4 border-blue-100 text-blue-600 font-bold flex items-center justify-center text-xl shadow-sm">
                1
              </div>
              <span class="font-bold text-slate-800 leading-tight">Check your<br>inbox & junk</span>
            </div>

            <div class="flex flex-col items-center gap-4 w-full md:w-1/3 px-2">
              <div class="w-14 h-14 min-w-[3.5rem] shrink-0 rounded-full bg-white border-4 border-blue-100 text-blue-600 font-bold flex items-center justify-center text-xl shadow-sm">
                2
              </div>
              <span class="font-bold text-slate-800 leading-tight">Prepare your<br>numbers</span>
            </div>

            <div class="flex flex-col items-center gap-4 w-full md:w-1/3 px-2">
              <div class="w-14 h-14 min-w-[3.5rem] shrink-0 rounded-full bg-white border-4 border-blue-100 text-blue-600 font-bold flex items-center justify-center text-xl shadow-sm">
                3
              </div>
              <span class="font-bold text-slate-800 leading-tight">Join via<br>Meets</span>
            </div>
            
          </div>
        </div>

        <a href="/" class="block w-fit mx-auto px-8 py-4 font-bold text-white bg-slate-900 rounded-full hover:bg-blue-600 transition-all shadow-lg shadow-slate-900/20 hover:scale-105 whitespace-nowrap">
          Return to Homepage
        </a>
      </div>

    </div>

  </main>

</Layout>