---
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    "title": "Risk-Transfer Economics",
    "description": "We believe the burden of proof is on the builder. By linking our final service payment to your pre-defined revenue milestones, we ensure that our infrastructure is a profit-generating asset before it is a cost.",
    icon: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z",
    "color": "text-blue-600",
    "bg": "bg-blue-50"
},
  {
    title: "Strategy-Governed Labor",
    description: "Automation without foundational logic is just high-speed noise. Our core principle is that human-led strategy must govern the \"Neural Layer,\" ensuring every AI-driven touchpoint reflects high-level psychological conversion.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10",
    color: "text-indigo-600",
    bg: "bg-indigo-50"
  },
  {
    title: "Non-Disruptive Evolution",
    description: "We never compromise a live revenue stream to build a new one. Our logic centers on the \"Parallel Build,\" where we engineer and test your new architecture in a shadow environment until it outperforms your current benchmarks.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    color: "text-purple-600",
    bg: "bg-purple-50"
  }
];
---

<Layout title="Our Philosophy | Eversales">
  <style>
    @keyframes floatUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-entry {
      animation: floatUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
    }

    .spotlight-item {
      position: relative;
      overflow: hidden;
      --mouse-x: 50%;
      --mouse-y: 50%;
    }
    .spotlight-item::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(400px circle at var(--mouse-x) var(--mouse-y), rgba(37, 99, 235, 0.08), transparent 40%);
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
      z-index: 10;
    }
    .spotlight-item:hover::after {
      opacity: 1;
    }
  </style>

  <main class="bg-slate-50 pt-16">
    <section class="py-24 md:py-32 relative overflow-hidden bg-white border-b border-slate-100">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] bg-blue-500/5 blur-[120px] rounded-full -z-10"></div>
      
      <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="animate-entry inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-[10px] font-bold uppercase tracking-widest mb-8">
            Established 2024 • Our Purpose
        </div>
        <h1 class="animate-entry text-5xl md:text-7xl font-extrabold text-slate-900 tracking-tight mb-8">
          We build the engines that <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-500">power growth.</span>
        </h1>
        <p class="animate-entry [animation-delay:0.2s] text-xl text-slate-500 leading-relaxed max-w-2xl mx-auto">
          EverSales was founded on a simple realization: Most SMBs don't have a talent problem—they have an <strong>architecture</strong> problem.
        </p>
      </div>
    </section>

    <section class="py-24 px-6">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-stretch">
        <div class="spotlight-item bg-white p-10 md:p-16 rounded-[3rem] border border-slate-100 shadow-sm flex flex-col justify-center transition-all duration-500">
            <span class="text-slate-400 font-bold text-xs uppercase tracking-widest mb-4">The Old Way</span>
            <h2 class="text-3xl font-bold text-slate-900 mb-6">The "Hero-Dependent" Model</h2>
            <p class="text-lg text-slate-500 leading-relaxed mb-8">
                Relying on one or two high-performing individuals to carry your revenue. When they leave, your growth stops. This is a fragile system built on "magic" rather than logic.
            </p>
            <div class="space-y-4">
                <div class="flex items-center gap-3 text-slate-400 font-medium line-through decoration-slate-300">
                    <div class="w-2 h-2 rounded-full bg-slate-200"></div>
                    Traditional Sales Clients are Tired of.
                </div>
                <div class="flex items-center gap-3 text-slate-400 font-medium line-through decoration-slate-300">
                    <div class="w-2 h-2 rounded-full bg-slate-200"></div>
                    Expensive Margin-Eating inefficiencies.
                </div>
            </div>
        </div>

        <div class="spotlight-item bg-slate-900 p-10 md:p-16 rounded-[3rem] shadow-2xl flex flex-col justify-center relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 blur-[80px] rounded-full"></div>
            <span class="text-blue-400 font-bold text-xs uppercase tracking-widest mb-4 relative z-20">The EverSales Way</span>
            <h2 class="text-3xl font-bold text-white mb-6 relative z-20">The "System-Driven" Engine</h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-8 relative z-20">
                We deliver high-value psychological conversion frameworks and automated infrastructure that ensure your growth scales predictably and profitably.
            </p>
            <div class="space-y-4 relative z-20">
                <div class="flex items-center gap-3 text-blue-100 font-bold">
                    <div class="w-2 h-2 rounded-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.8)]"></div>
                    Behavioral Psychology Based Closing.
                </div>
                <div class="flex items-center gap-3 text-blue-100 font-bold">
                    <div class="w-2 h-2 rounded-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.8)]"></div>
                    Maximized Profit Margins via AI Automation.
                </div>
            </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white border-y border-slate-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-extrabold text-slate-900 mb-4 tracking-tight">Our Core Logic</h2>
          <div class="h-1 w-20 bg-blue-600 mx-auto rounded-full"></div>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {pillars.map(pillar => (
            <div class="spotlight-item bg-slate-50 p-10 rounded-[2.5rem] border border-slate-100 transition-all duration-500 hover:shadow-xl hover:bg-white group/pillar">
              <div class={`w-14 h-14 ${pillar.bg} ${pillar.color} rounded-2xl flex items-center justify-center mb-8 group-hover/pillar:scale-110 transition-transform duration-500`}>
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.icon}/></svg>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-4 tracking-tight">{pillar.title}</h3>
              <p class="text-slate-500 leading-relaxed text-sm">{pillar.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-50 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6 tracking-tight">Ready to meet the <br/> architects?</h2>
        <p class="text-lg text-slate-500 max-w-xl mx-auto mb-12 leading-relaxed">
          We don't operate as consultants. We operate as your fractional sales infrastructure team. 
        </p>

        <div class="spotlight-item bg-white p-2 rounded-3xl shadow-xl border border-slate-200 inline-flex flex-col sm:flex-row gap-2 w-full max-w-lg mb-12 transition-all duration-500">
            <a href="/book" class="relative z-20 flex-1 px-8 py-5 bg-slate-900 text-white font-bold rounded-2xl hover:bg-blue-600 transition-all text-center">
              Book Your Diagnostic
            </a>
            <a href="/services" class="relative z-20 flex-1 px-8 py-5 bg-slate-50 text-slate-700 font-bold rounded-2xl hover:bg-slate-100 transition-all text-center">
              View Our Programs
            </a>
        </div>

      </div>

      <div class="absolute inset-0 z-0 opacity-20 pointer-events-none" 
           style="background-image: radial-gradient(circle at 2px 2px, #cbd5e1 1px, transparent 0); background-size: 40px 40px;">
      </div>
    </section>
  </main>

  <script>
    function initSpotlight() {
      const items = document.querySelectorAll('.spotlight-item');
      items.forEach(el => {
        el.addEventListener('mousemove', (e) => {
          const rect = (el as HTMLElement).getBoundingClientRect();
          const x = (e as MouseEvent).clientX - rect.left;
          const y = (e as MouseEvent).clientY - rect.top;
          (el as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
          (el as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initSpotlight);
    document.addEventListener('astro:page-load', initSpotlight);
  </script>
</Layout>