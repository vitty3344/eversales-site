---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

// =========================================
// PARTNER LOGO CONFIGURATION
// =========================================
const partners = [
  { 
    name: "Apex Capital", 
    logo: "/logos/apex.png", // RESTORED
    path: "M12 2L2 7l10 5 10-5-10-5zm0 9l2.5-1.25L12 8.5l-2.5 1.25L12 11zm0 2.5l-5-2.5-5 2.5L12 22l10-8.5-5-2.5-5 2.5z" 
  },
  { 
    name: "Global Ventures", 
    logo: "/logos/global.png", // RESTORED
    path: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" 
  },
  { 
    name: "ScaleUp Inc", 
    logo: "/logos/scaleup.png", // RESTORED
    path: "M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" 
  },
  { 
    name: "Foundry Group", 
    logo: "/logos/foundry.png", // RESTORED
    path: "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23 1.12 4.81z" 
  },
  { 
    name: "NextLevel", 
    logo: "/logos/nextlevel.png", // RESTORED
    path: "M12 2L2 7l10 5 10-5-10-5zm0 9l2.5-1.25L12 8.5l-2.5 1.25L12 11zm0 2.5l-5-2.5-5 2.5L12 22l10-8.5-5-2.5-5 2.5z" 
  }
];

const block = [...partners, ...partners]; // Simplified for clean infinite scroll
---

<Layout title="The Growth Ecosystem">
  <style is:global>
    html { scroll-behavior: smooth; }
    
    @keyframes floatUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-entry { animation: floatUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }

    .spotlight-item { position: relative; overflow: hidden; --mouse-x: 50%; --mouse-y: 50%; }
    .spotlight-item::after {
      content: ""; position: absolute; inset: 0; border-radius: inherit;
      background: radial-gradient(400px circle at var(--mouse-x) var(--mouse-y), rgba(37, 99, 235, 0.12), transparent 40%);
      opacity: 0; transition: opacity 0.5s ease; pointer-events: none; z-index: 10;
    }
    .spotlight-item:hover::after { opacity: 1; }

    @keyframes scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); } 
    }
    .animate-scroll { animation: scroll 40s linear infinite; width: max-content; }
  </style>

  <section class="relative pt-24 pb-20 md:pt-32 md:pb-32 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-blue-400/10 blur-[120px] rounded-full -z-10"></div>
    <div class="max-w-7xl mx-auto px-6 flex flex-col items-center text-center">
      <div class="animate-entry inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-xs font-bold uppercase tracking-wide mb-8">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        Accepting New Partners for Q1
      </div>
      <h1 class="animate-entry delay-1 text-5xl md:text-7xl font-extrabold text-slate-900 tracking-tight mb-8 max-w-4xl leading-tight">
        Build a Sales Engine that <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">runs without you.</span>
      </h1>
      <p class="animate-entry delay-2 text-lg md:text-xl text-slate-500 max-w-2xl mb-10">
        We install the infrastructure, hire the talent, and train the team to scale your revenue predictably.
      </p>
      <div class="animate-entry delay-3 flex flex-col sm:flex-row gap-4">
        <a href="#engine-section" class="px-8 py-4 text-base font-bold text-white bg-slate-900 rounded-full hover:bg-blue-600 transition-all shadow-xl shadow-slate-900/20">See How It Works</a>
        <a href="/events" class="spotlight-item px-8 py-4 text-base font-bold text-slate-700 bg-white border border-slate-200 rounded-full">View Live Workshops</a>
      </div>
    </div>
  </section>

  <section class="py-6 border-y border-slate-100 bg-white overflow-hidden">
    <div class="relative w-full overflow-hidden" style="mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);">
      <div class="flex items-center animate-scroll opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
        {[1, 2].map(() => (
          <div class="flex items-center gap-16 px-8">
            {block.map(partner => (
              <span class="text-sm font-bold text-slate-500 flex items-center gap-3 whitespace-nowrap">
                {partner.logo ? (
                  <img src={partner.logo} alt={partner.name} class="h-6 w-auto object-contain" onerror="this.style.display='none'" />
                ) : (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d={partner.path}/></svg>
                )}
                {partner.name}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="engine-section" class="bg-white relative py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">How We Build Your Engine</h2>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">A predictable system requires a predictable installation.</p>
      </div>

      <div class="flex flex-col md:flex-row gap-12">
        <div class="hidden md:block w-1/3 sticky top-32 h-fit">
          <div class="bg-slate-900 rounded-3xl p-8 shadow-2xl text-white relative overflow-hidden min-h-[400px] flex flex-col justify-between" id="monitor-card">
            <div id="monitor-blob" class="absolute top-0 right-0 w-64 h-64 bg-blue-600/30 blur-[80px] rounded-full -translate-y-1/2 translate-x-1/2 transition-all duration-700"></div>
            <div class="relative z-10 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-widest text-slate-400">System Status</span>
              <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            </div>
            <div class="relative z-10">
              <span id="monitor-number" class="text-8xl font-black text-white/20 transition-all duration-500">01</span>
            </div>
            <div class="relative z-10">
              <h3 id="monitor-title" class="text-2xl font-bold mb-2">Diagnostic</h3>
              <div class="h-1.5 w-full bg-slate-800 rounded-full overflow-hidden">
                <div id="monitor-progress" class="h-full bg-blue-500 w-1/4 transition-all duration-700"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="w-full md:w-2/3 space-y-32 pb-32">
          {["Diagnostic Audit", "Custom Blueprint", "Active Installation", "System Handoff"].map((title, i) => (
            <div class="step-trigger min-h-[40vh] border-l-2 border-slate-100 pl-8 md:pl-16" data-step={i + 1}>
              <span class="text-blue-600 font-bold text-lg mb-4 block">0{i + 1}. Phase {i + 1}</span>
              <h3 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">{title}</h3>
              <p class="text-lg text-slate-500 leading-relaxed max-w-lg">
                Step details for {title.toLowerCase()} focus on installing infrastructure and ensuring predictability.
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    function initMonitor() {
      const triggers = document.querySelectorAll('.step-trigger');
      const numberEl = document.getElementById('monitor-number');
      const titleEl = document.getElementById('monitor-title');
      const progressEl = document.getElementById('monitor-progress');
      const blobEl = document.getElementById('monitor-blob');

      const dataMap = {
        "1": { title: "Diagnostic", progress: "25%", color: "rgba(37, 99, 235, 0.3)" },
        "2": { title: "Blueprint", progress: "50%", color: "rgba(79, 70, 229, 0.3)" },
        "3": { title: "Installation", progress: "75%", color: "rgba(147, 51, 234, 0.3)" },
        "4": { title: "Handoff", progress: "100%", color: "rgba(34, 197, 94, 0.3)" }
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const step = entry.target.getAttribute('data-step');
            const data = dataMap[step];
            if (data && numberEl && titleEl && progressEl && blobEl) {
              numberEl.innerText = `0${step}`;
              titleEl.innerText = data.title;
              progressEl.style.width = data.progress;
              blobEl.style.backgroundColor = data.color;
            }
          }
        });
      }, { threshold: 0.6 });

      triggers.forEach(t => observer.observe(t));
    }

    function initSpotlight() {
      document.querySelectorAll('.spotlight-item').forEach(el => {
        el.addEventListener('mousemove', (e: any) => {
          const rect = el.getBoundingClientRect();
          (el as HTMLElement).style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          (el as HTMLElement).style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => { initMonitor(); initSpotlight(); });
    document.addEventListener('astro:page-load', () => { initMonitor(); initSpotlight(); });
  </script>
</Layout>