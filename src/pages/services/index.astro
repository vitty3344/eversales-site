---
import Layout from '../../layouts/Layout.astro';

const comparisons = [
  {
    friction: "Founder-led selling that doesn't scale.",
    flow: "Systems that work while you sleep.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    friction: "Leaky CRM and 'guessing' at the numbers.",
    flow: "Total data visibility and predictable ROI.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10"
  },
  {
    friction: "Missing quotas and inconsistent talent.",
    flow: "High-performance team with a proven playbook.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857"
  }
];
---

<Layout title="Services | Eversales">
  <style>
    @keyframes floatUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-entry {
      animation: floatUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
    }

    .spotlight-item {
      position: relative;
      overflow: hidden;
      --mouse-x: 50%;
      --mouse-y: 50%;
    }
    .spotlight-item::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(400px circle at var(--mouse-x) var(--mouse-y), rgba(37, 99, 235, 0.08), transparent 40%);
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
      z-index: 10;
    }
    .spotlight-item:hover::after {
      opacity: 1;
    }

    .scroll-mt-24 {
      scroll-margin-top: 6rem;
    }
  </style>

  <main class="bg-slate-50 pt-16">
    <section class="py-20 md:py-32 relative overflow-hidden bg-white border-b border-slate-100">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] bg-blue-500/5 blur-[120px] rounded-full -z-10"></div>
      <div class="max-w-7xl mx-auto px-6 text-center">
        <div class="animate-entry inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-[10px] font-bold uppercase tracking-widest mb-8">
          The Future of Sales Architecture
        </div>
        <h1 class="animate-entry text-5xl md:text-7xl font-extrabold text-slate-900 tracking-tight mb-8">
          One Engine. <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-500">Two Paths to Scale.</span>
        </h1>
        <p class="animate-entry [animation-delay:0.2s] text-lg md:text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed">
          We install the sales infrastructure required for SMBs to scale, augmented with AI to remove manual friction and double your revenue velocity.
        </p>
      </div>
    </section>

    <section id="accelerator" class="py-24 px-6 scroll-mt-24">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2 spotlight-item bg-white p-10 md:p-12 rounded-[2.5rem] border border-slate-100 shadow-sm transition-all duration-500">
          <div class="inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-lg bg-blue-600/10 text-blue-600 text-xs font-bold uppercase tracking-wider">
            Founder to CEO Transition
          </div>
          <h2 class="text-4xl font-bold text-slate-900 mb-6 tracking-tight">AI-Augmented Startup Sales Accelerator</h2>
          <p class="text-xl text-slate-600 mb-8 leading-relaxed relative z-20">
            Stop being the bottleneck. We extract your "Founder Magic" and scale it using custom AI agents that handle lead research and personalized outreach while we hire your first rep.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10 relative z-20">
            <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-100 spotlight-item transition-all">
                <span class="text-blue-600 font-bold relative z-20">01.</span>
                <span class="text-slate-700 font-medium relative z-20">Magic Extraction</span>
            </div>
            <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-100 spotlight-item transition-all">
                <span class="text-blue-600 font-bold relative z-20">02.</span>
                <span class="text-slate-700 font-medium relative z-20">AI Agent Setup</span>
            </div>
          </div>
          <a href="/book" class="inline-flex items-center px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-blue-600 transition-all relative z-20">
            Launch Your Engine
          </a>
        </div>
        <div class="lg:w-1/2">
          <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&q=80&w=1200" class="rounded-[3rem] border border-white shadow-2xl" alt="Tech Startup Team" />
        </div>
      </div>
    </section>

    <section id="architecture" class="py-24 px-6 bg-white border-y border-slate-100 scroll-mt-24">
      <div class="max-w-7xl mx-auto flex flex-col lg:flex-row-reverse gap-16 items-center">
        <div class="lg:w-1/2 spotlight-item bg-slate-50 p-10 md:p-12 rounded-[2.5rem] border border-slate-200 transition-all duration-500">
          <div class="inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-lg bg-indigo-600/10 text-indigo-600 text-xs font-bold uppercase tracking-wider">
            Precision Re-engineering
          </div>
          <h2 class="text-4xl font-bold text-slate-900 mb-6 tracking-tight">Sales Architecture for SMEs</h2>
          <p class="text-xl text-slate-600 mb-8 leading-relaxed relative z-20">
            Transform a fragmented team into a precision unit. We deploy AI auditing to find hidden objections in your calls and rebuild your architecture based on real-world data.
          </p>
          <div class="space-y-4 mb-10 relative z-20">
            <div class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-slate-200 spotlight-item transition-all">
                <div class="w-10 h-10 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold relative z-20">10%</div>
                <p class="text-slate-600 font-medium relative z-20">Finding leaks in 100% of calls.</p>
            </div>
          </div>
          <a href="/book" class="inline-flex items-center px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-indigo-600 transition-all relative z-20">
            Unblock Performance
          </a>
        </div>
        <div class="lg:w-1/2">
          <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&q=80&w=1200" class="rounded-[3rem] border border-slate-200 shadow-xl" alt="Professional SMB Team" />
        </div>
      </div>
    </section>

    <section class="py-24 bg-white border-b border-slate-100 overflow-hidden">
      <div class="max-w-7xl mx-auto px-6">
        <div class="bg-slate-900 rounded-[3rem] p-8 md:p-20 border border-slate-800 relative shadow-2xl overflow-hidden group spotlight-item transition-all duration-500">
          
          <div class="relative z-10 grid lg:grid-cols-2 gap-16 items-center">
            <div class="max-w-md">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-[10px] font-black uppercase tracking-widest mb-6">
                Shared Core Technology
              </div>
              <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight leading-tight">
                The Intelligence Layer <br/> Beneath Every Engine.
              </h2>
              <p class="text-lg text-slate-400 leading-relaxed mb-8">
                We install a standardized layer that removes manual overhead and provides total data visibility to leadership.
              </p>
            </div>

            <div class="flex flex-col gap-6 relative z-20">
               <div class="spotlight-item bg-white/5 p-8 rounded-[2rem] border border-white/10 transition-all duration-500 group/item hover:bg-white/[0.07]">
                  <div class="flex items-start gap-6">
                    <div class="w-12 h-12 rounded-2xl bg-blue-600/20 border border-blue-500/20 flex items-center justify-center shrink-0">
                      <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <div>
                      <h4 class="text-xl font-bold text-white mb-2">Psychology-based human frameworks.</h4>
                      <p class="text-sm text-slate-400 leading-relaxed">High-level negotiation strategy and tailored objection handling built into every script.</p>
                    </div>
                  </div>
               </div>

               <div class="spotlight-item bg-white/5 p-8 rounded-[2rem] border border-white/10 transition-all duration-500 group/item hover:bg-white/[0.07]">
                  <div class="flex items-start gap-6">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-600/20 border border-indigo-500/20 flex items-center justify-center shrink-0">
                      <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                    <div>
                      <h4 class="text-xl font-bold text-white mb-2">Data-driven AI automation.</h4>
                      <p class="text-sm text-slate-400 leading-relaxed">Automated research agents and real-time CRM data enrichment to maximize team velocity.</p>
                    </div>
                  </div>
               </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-slate-50 relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6 tracking-tight">Ready to Initialize?</h2>
        <p class="text-lg text-slate-500 max-w-xl mx-auto mb-12">
          Every great engine starts with a diagnostic. No sales pitch, just a thorough review of your architecture.
        </p>

        <div class="spotlight-item bg-white p-2 rounded-3xl shadow-xl border border-slate-200 inline-flex flex-col sm:flex-row gap-2 w-full max-w-lg mb-8 transition-all duration-500">
            <a href="/book" class="relative z-20 flex-1 px-8 py-5 bg-slate-900 text-white font-bold rounded-2xl hover:bg-blue-600 transition-all text-center">
              Book Your Audit
            </a>
            <a href="/events" class="relative z-20 flex-1 px-8 py-5 bg-slate-50 text-slate-700 font-bold rounded-2xl hover:bg-slate-100 transition-all text-center">
              Browse Workshops
            </a>
        </div>

        <div class="flex items-center justify-center gap-8 opacity-40">
            <div class="flex flex-col items-center gap-1">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-tighter">Status</span>
                <span class="text-xs font-bold text-slate-900">READY</span>
            </div>
            <div class="w-px h-6 bg-slate-300"></div>
            <div class="flex flex-col items-center gap-1">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-tighter">Region</span>
                <span class="text-xs font-bold text-slate-900">GLOBAL</span>
            </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    function initSpotlight() {
      const items = document.querySelectorAll('.spotlight-item');
      items.forEach(el => {
        el.addEventListener('mousemove', (e) => {
          const rect = (el as HTMLElement).getBoundingClientRect();
          const x = (e as MouseEvent).clientX - rect.left;
          const y = (e as MouseEvent).clientY - rect.top;
          (el as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
          (el as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initSpotlight);
    document.addEventListener('astro:page-load', initSpotlight);
  </script>
</Layout>