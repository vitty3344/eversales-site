  <script>
    let monitorObserver;

    function initMonitor() {
  if (monitorObserver) monitorObserver.disconnect();

  const triggers = document.querySelectorAll('.engine-track.active .step-trigger');
  const numberEl = document.getElementById('monitor-number');
  const titleEl = document.getElementById('monitor-title');
  const progressEl = document.getElementById('monitor-progress');
  const blobEl = document.getElementById('monitor-blob');

  if (!numberEl || !titleEl) return;

  monitorObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      // We check for isIntersecting to update the UI
      if (entry.isIntersecting) {
        const step = entry.target.getAttribute('data-step');
        const title = entry.target.getAttribute('data-title');
        const progress = entry.target.getAttribute('data-progress');
        const colorClass = entry.target.getAttribute('data-color');
        
        numberEl.innerText = `0${step}`;
        titleEl.innerText = title;
        if(progressEl) progressEl.style.width = progress;
        if(blobEl) blobEl.className = `absolute top-0 right-0 w-64 h-64 blur-[80px] rounded-full -translate-y-1/2 translate-x-1/2 transition-colors duration-500 ${colorClass}`;
        
        numberEl.classList.add('opacity-50', 'scale-95');
        setTimeout(() => numberEl.classList.remove('opacity-50', 'scale-95'), 100);
      }
    });
  }, { 
    /* Adjusting rootMargin to -45% top and bottom.
       This creates a very narrow 'trigger zone' (10% of the viewport height) 
       exactly in the middle of the screen. 
    */
    rootMargin: "-45% 0px -45% 0px", 
    threshold: 0 
  });

  triggers.forEach(trigger => monitorObserver.observe(trigger));
}

    function initTabs() {
      const tabBtns = document.querySelectorAll('.engine-tab-btn');
      const tracks = document.querySelectorAll('.engine-track');
      const bubble = document.getElementById('tab-bubble');

      function updateBubble(activeBtn) {
        if (!bubble) return;
        bubble.style.width = `${activeBtn.offsetWidth}px`;
        bubble.style.left = `${activeBtn.offsetLeft}px`;
      }

      // Initialize bubble position
      const initialActive = document.querySelector('.engine-tab-btn.text-slate-900');
      if (initialActive) updateBubble(initialActive as HTMLElement);

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');

          // Bubble & Text Color
          updateBubble(btn as HTMLElement);
          tabBtns.forEach(b => {
             b.classList.remove('text-slate-900');
             b.classList.add('text-slate-500');
          });
          btn.classList.add('text-slate-900');
          btn.classList.remove('text-slate-500');

          // Track Switch with Animation
          tracks.forEach(track => {
            if (track.id === `track-${target}`) {
              track.classList.remove('hidden');
              setTimeout(() => track.classList.add('active'), 10);
            } else {
              track.classList.remove('active');
              track.classList.add('hidden');
            }
          });

          // Reset Monitor for new track
          setTimeout(initMonitor, 400); 
        });
      });
    }

    function initSpotlight() {
      const items = document.querySelectorAll('.spotlight-item');
      items.forEach(el => {
        el.addEventListener('mousemove', (e) => {
          const rect = (el as HTMLElement).getBoundingClientRect();
          const x = (e as MouseEvent).clientX - rect.left;
          const y = (e as MouseEvent).clientY - rect.top;
          (el as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
          (el as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }

    function initAll() {
      initTabs();
      initMonitor();
      initSpotlight();
    }

    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('astro:page-load', initAll);
    window.addEventListener('resize', () => {
      const active = document.querySelector('.engine-tab-btn.text-slate-900');
      if (active) {
        const bubble = document.getElementById('tab-bubble');
        if (bubble) {
          bubble.style.width = `${(active as HTMLElement).offsetWidth}px`;
          bubble.style.left = `${(active as HTMLElement).offsetLeft}px`;
        }
      }
    });
  </script>

</Layout>