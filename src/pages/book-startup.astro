---
// src/pages/book.astro
import Layout from '../layouts/Layout.astro';
import BookingSection from '../components/BookingSection.astro';

const Features = [
  "Identify critical points of friction and systemic leakage in your sales cycle",
  "An audit of current versus projected post-implementation performance.",
  "A roadmap for Infrastructure deployment and training designed for operational continuity."
];
---

<Layout title="Book a Startup Diagnostic Call | Eversales">
  
  <main class="pt-20">
    <BookingSection 
      title="Book a Sales Diagnostic Call For Your Start-Up."
      subtitle="Select a time below for a 30-minute diagnostic call."
      calendarUrl="https://calendly.com/hello-eversales/30-minute-startup"
      features={Features}
    />
  </main>

</Layout>